# Staging is the SAME modules as dev with different values.
# Day 21: resist the urge to copy main.tf and start editing it - that is how
# environments drift apart. Only the values should differ.
aws_region  = "ap-south-1"
project     = "newrelic-fleet"
environment = "staging"

vpc_cidr           = "10.20.0.0/16"
availability_zones = ["ap-south-1a", "ap-south-1b"]

instance_type    = "t3.small"
min_size         = 2
max_size         = 4
desired_capacity = 2

enable_monitoring_module = true
newrelic_region          = "US"
