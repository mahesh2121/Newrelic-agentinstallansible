# CI workflow - READY TO USE, but not installed.
#
# It lives here (not in .github/workflows/) because the GitHub App credential used
# to push this branch is not granted the `workflows` permission, and GitHub
# refuses to let an App create or update files under .github/workflows/.
#
# To activate it, a human with repo admin must run:
#     mkdir -p .github/workflows
#     git mv .github/ci.yml.example .github/workflows/ci.yml
#     git commit -m "ci: install workflow"
#
# Every command it runs is the same one `make verify` runs locally, so you can
# validate the pipeline before installing it:
#     make verify
#
# Repository secrets it expects (only for the plan/deploy jobs):
#     AWS_PLAN_ROLE_ARN    IAM role for `terraform plan` (read-only)
#     AWS_DEPLOY_ROLE_ARN  IAM role for `terraform apply` (write)
#     ANSIBLE_VAULT_PASSWORD  (only if you keep secrets in ansible-vault)

name: ci

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch: {}

# Pin the versions this repo was validated with (see docs/VERIFICATION.md).
env:
  PYTHON_VERSION: "3.11"
  ANSIBLE_LINT_EXPECTED: "26.x"

jobs:
  # -------------------------------------------------------------------------
  # Levels 1-3: static, schema and policy checks. Fast, no cloud access.
  # -------------------------------------------------------------------------
  lint-and-scan:
    name: Lint, parse and scan
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: pip

      - name: Install tooling
        run: |
          python -m pip install --upgrade pip
          python -m pip install ansible-core==2.19.* ansible-lint==26.* \
                                yamllint checkov python-hcl2

      - name: Versions (record these in the job log)
        run: |
          ansible --version | head -2
          ansible-lint --version
          yamllint --version
          checkov --version | tail -1

      - name: YAML lint
        run: yamllint .

      - name: Ansible lint (production profile)
        working-directory: ansible
        run: ansible-lint

      - name: Syntax check every playbook
        working-directory: ansible
        run: |
          for p in playbooks/*.yml ../labs/local/lab.yml; do
            echo "-- $p"
            ansible-playbook --syntax-check "$p"
          done

      - name: HCL parse check
        run: python3 tools/hcl_parse_check.py

      - name: Checkov security/policy scan
        run: checkov --config-file .checkov.yaml

  # -------------------------------------------------------------------------
  # Level 4: behaviour. The only stage that proves anything works.
  # -------------------------------------------------------------------------
  integration-lab:
    name: Integration lab (the Terraform -> Ansible bridge)
    runs-on: ubuntu-latest
    needs: lint-and-scan
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}
          cache: pip

      - name: Install tooling
        run: |
          python -m pip install --upgrade pip
          python -m pip install ansible-core==2.19.* pyyaml

      - name: Local lab, first run
        working-directory: ansible
        run: ansible-playbook ../labs/local/lab.yml | tee /tmp/run1.log

      - name: Local lab, second run must be idempotent
        working-directory: ansible
        run: |
          ansible-playbook ../labs/local/lab.yml | tee /tmp/run2.log
          grep -q "changed=0" /tmp/run2.log || {
            echo "::error::Playbook is not idempotent"; cat /tmp/run2.log; exit 1; }

      - name: Assert a recap was actually printed
        run: |
          grep -q "PLAY RECAP" /tmp/run1.log || {
            echo "::error::No PLAY RECAP - the run produced no output"; exit 1; }

      - name: Bridge lab (state -> inventory -> playbook -> rendered config)
        run: bash labs/local/mock_bridge.sh | tee /tmp/bridge.log

      - name: Assert the bridge produced valid, Terraform-derived config
        run: |
          grep -q "PASS  config.copy"      /tmp/bridge.log || exit 1
          grep -q "PASS  integration.copy" /tmp/bridge.log || exit 1
          grep -q "PASS  display_name came from Terraform state" /tmp/bridge.log || exit 1

      - name: Dynamic inventory script
        working-directory: ansible
        run: |
          TF_STATE_FILE=../labs/local/sample.tfstate.json \
            ansible-inventory -i inventory/terraform.py --graph

  # -------------------------------------------------------------------------
  # Terraform plan. Needs credentials - skipped for forks.
  # -------------------------------------------------------------------------
  plan:
    name: Terraform plan (${{ matrix.environment }})
    runs-on: ubuntu-latest
    needs: [lint-and-scan, integration-lab]
    if: github.event_name == 'pull_request' && github.event.pull_request.head.repo.full_name == github.repository
    permissions:
      id-token: write
      contents: read
      pull-requests: write
    strategy:
      matrix:
        environment: [dev]
    steps:
      - uses: actions/checkout@v4

      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.9.8

      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_PLAN_ROLE_ARN }}
          aws-region: ap-south-1

      - name: Init
        working-directory: terraform/environments/${{ matrix.environment }}
        run: terraform init -input=false -backend=false

      - name: Format check
        working-directory: terraform
        run: terraform fmt -check -recursive

      - name: Validate
        working-directory: terraform/environments/${{ matrix.environment }}
        run: terraform validate

      - name: Plan
        working-directory: terraform/environments/${{ matrix.environment }}
        run: |
          terraform plan -input=false -no-color -out=tfplan
          terraform show -no-color tfplan > plan.txt

      - name: Upload the reviewed plan
        uses: actions/upload-artifact@v4
        with:
          name: tfplan-${{ matrix.environment }}-${{ github.sha }}
          path: terraform/environments/${{ matrix.environment }}/tfplan
          retention-days: 7

      - name: Comment the plan on the PR
        env:
          GH_TOKEN: ${{ github.token }}
        run: |
          {
            echo '### terraform plan (${{ matrix.environment }})'
            echo '```'
            tail -40 terraform/environments/${{ matrix.environment }}/plan.txt
            echo '```'
          } > /tmp/plan-comment.md
          gh pr comment "${{ github.event.pull_request.number }}" --body-file /tmp/plan-comment.md

  # -------------------------------------------------------------------------
  # Apply on merge. Uses the reviewed plan artifact - never a fresh plan.
  # -------------------------------------------------------------------------
  deploy:
    name: Deploy (${{ inputs.environment || 'dev' }})
    runs-on: ubuntu-latest
    if: github.event_name == 'workflow_dispatch' || (github.event_name == 'push' && github.ref == 'refs/heads/main')
    concurrency:
      group: deploy-${{ inputs.environment || 'dev' }}
      cancel-in-progress: false
    environment:
      name: ${{ inputs.environment || 'dev' }}
    permissions:
      id-token: write
      contents: read
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ env.PYTHON_VERSION }}

      - uses: hashicorp/setup-terraform@v3
        with:
          terraform_version: 1.9.8

      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: ${{ secrets.AWS_DEPLOY_ROLE_ARN }}
          aws-region: ap-south-1

      - name: Install Ansible
        run: python -m pip install ansible-core==2.19.*

      - name: Plan, apply, generate inventory, configure, verify
        env:
          ENVIRONMENT: ${{ inputs.environment || 'dev' }}
        run: bash terraform/scripts/deploy.sh "${ENVIRONMENT}"

      - name: Upload the generated inventory as an audit artifact
        uses: actions/upload-artifact@v4
        with:
          name: inventory-${{ inputs.environment || 'dev' }}-${{ github.sha }}
          path: ansible/inventory/generated/
          retention-days: 30
          if-no-files-found: warn
