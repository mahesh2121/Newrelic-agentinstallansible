# yamllint configuration. Run with:  yamllint .   (from the repository root)
extends: default

ignore: |
  .git/
  .facts/
  collections/
  node_modules/

rules:
  line-length:
    max: 200
    level: warning
  comments:
    min-spaces-from-content: 1
  truthy:
    allowed-values: ['true', 'false', 'yes', 'no']
    check-keys: false
  # Disabled on purpose. Ansible convention is to start files with `---`;
  # `present: false` warns on every such file, and `present: true` warns on the
  # config files in this repo that legitimately start with a comment.
  document-start: disable
  indentation:
    spaces: 2
    indent-sequences: consistent
  braces:
    max-spaces-inside: 1
  brackets:
    max-spaces-inside: 1
  empty-lines:
    max: 2
